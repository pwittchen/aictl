{
  "productName": "aictl",
  "version": "0.47.2",
  "identifier": "com.piotrwittchen.aictl",
  "build": {
    "frontendDist": "webview/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "aictl",
        "width": 1100,
        "height": 880,
        "minWidth": 935,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 20, "y": 26 },
        "resizable": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: asset: https://asset.localhost https://*.tile.openstreetmap.org https://server.arcgisonline.com https://*.basemaps.cartocdn.com; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.icns", "icons/icon.png"],
    "category": "DeveloperTool",
    "shortDescription": "AI agent on the desktop",
    "longDescription": "aictl-desktop is the native macOS frontend for aictl, sharing config and sessions with the CLI.",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "frameworks": [],
      "entitlements": "entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/pwittchen/aictl/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMwQkVCMTY0NjE3Mzc5QjQKUldTMGVYTmhaTEcrTU9iZU9jQjZpQVhkdTNuU0lLSVVCNERPVlA3azIrUXNDNzRTYlRkN2hVZE8K"
    }
  }
}
